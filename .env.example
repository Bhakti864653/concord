# Copy this file to ".env" and fill in real values there.
# Never commit the real ".env" file — it's already excluded via .gitignore.

SUPABASE_URL=your-project-url-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SECRET_KEY=your-service-role-key-here

# The one account allowed to trigger a matching run (checked by email, no
# separate admin role/table exists).
ADMIN_EMAIL=your-email-here
